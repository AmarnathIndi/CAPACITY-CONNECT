# ==============================================================================
# CAPACITY CONNECT — ENVIRONMENT CONFIGURATION (GOVERNMENT AIR-GAPPED DEPLOYMENT)
# Ministry of Earth Sciences (MoES) / India Meteorological Department (IMD)
# ==============================================================================

# Node Environment
NODE_ENV=production
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173,http://localhost:3000,https://capacityconnect.imd.gov.in

# Database Configuration (PostgreSQL 16 with pgvector)
DATABASE_URL=postgresql://imd_admin:IMD_Secure_Pass_2026!@postgres:5432/capacity_connect?schema=public
POSTGRES_USER=imd_admin
POSTGRES_PASSWORD=IMD_Secure_Pass_2026!
POSTGRES_DB=capacity_connect
POSTGRES_PORT=5432

# Redis Cache & Queue
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=IMD_Redis_Secret_2026!

# JWT Authentication
JWT_ACCESS_SECRET=IMD_Super_Secret_Jwt_Access_Key_Minimum_32_Chars_2026!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=IMD_Super_Secret_Jwt_Refresh_Key_Minimum_32_Chars_2026!
JWT_REFRESH_EXPIRATION=7d

# Two-Factor Authentication (TOTP for Administrators)
TOTP_APP_NAME="IMD CAPACITY CONNECT"

# S3 / MinIO Object Storage
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=imd_minio_admin
MINIO_ROOT_PASSWORD=IMD_MinIO_Super_Pass_2026!
MINIO_BUCKET_NAME=imd-capacity-connect
STORAGE_PUBLIC_URL=http://localhost:9000/imd-capacity-connect

# Email / SMTP Relay (Configurable to NIC / Government Relay)
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="CAPACITY CONNECT - IMD Training <training.capacity@imd.gov.in>"

# Local AI Inference (Ollama / vLLM — No external cloud APIs)
OLLAMA_BASE_URL=http://ollama:11434
LLM_MODEL=qwen2.5:7b
EMBEDDING_MODEL=bge-m3

# Speech-to-Text (Self-hosted Faster-Whisper)
WHISPER_SERVICE_URL=http://whisper:8008
WHISPER_MODEL=large-v3

# Jitsi Meet Integration (Self-Hosted Virtual Classroom)
JITSI_DOMAIN=meet.imd.gov.in
JITSI_APP_ID=capacity_connect
JITSI_APP_SECRET=IMD_Jitsi_Secret_Key_2026!

# PWA & Offline Sync
OFFLINE_TEST_SECRET=IMD_Offline_Test_Package_HMAC_Secret_2026!
